# Demo mode is ON by default: demo ribbon + search engines told not to index.
# Set to "false" in Vercel when the site goes live with real details.
NEXT_PUBLIC_DEMO=true

# Optional: enables the contact form email. Get a key at https://resend.com
RESEND_API_KEY=
# Where enquiries are delivered (defaults to site.email in src/config/site.ts)
CONTACT_TO_EMAIL=
# Verified sender in Resend, e.g. "Coach Nisha <noreply@yourdomain.ae>"
CONTACT_FROM_EMAIL=
